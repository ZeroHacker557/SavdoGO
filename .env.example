# ─── SavdoGO — server kalitlari ───────────────────────────────
# Vercel: Settings → Environment Variables (Production va Preview).
# Lokal: shu faylni `.env` nomi bilan nusxalang — `npm run dev` /api
# funksiyalarini ham ishga tushiradi va qiymatlarni shu yerdan oladi.
# Haqiqiy qiymatlar hech qachon git'ga tushmaydi (.gitignore).

# Firebase service account JSON — BUTUNLIGICHA, bitta qatorda.
# Firebase Console → Project Settings → Service accounts →
# «Generate new private key». Faylni ochib, JSON'ni to'liq nusxalang.
# ⚠️ src/config/firebase.ts dagi web config bilan BIR loyiha bo'lsin.
FIREBASE_SERVICE_ACCOUNT=

# Storage bucket. Bo'sh bo'lsa `<loyiha>.firebasestorage.app` olinadi
# (2024-yildan keyin yaratilgan loyihalar). Eski loyihada: `<loyiha>.appspot.com`
FIREBASE_STORAGE_BUCKET=

# Kunlik jadval (/api/cron) uchun maxfiy kalit — uzun tasodifiy satr.
# Vercel Cron uni o'zi yuboradi.
CRON_SECRET=

# ─── SavdoGO boti — hamma uchun bitta bot ────────────────────
# Telegram'da do'kon ochish va boshqarish, parolsiz kirish, o'z botini
# ulash, botsiz do'konlarga buyurtma xabarlari; sizga esa yangi do'kon va
# to'lov cheklari haqida xabar. Bot: @BotFather → /newbot.
# Token qo'yilgach: /super → Sozlamalar → «Botni sozlash» (webhook).
# Chat ID: botga /id yozing — u sizning chat ID ingizni qaytaradi.
PLATFORM_BOT_TOKEN=
PLATFORM_CHAT_ID=

# Obuna to'lovlari kartasi. Odatda /super → Sozlamalar'dan kiritiladi;
# bu yerdagi qiymat — u yerda hali kiritilmagan bo'lsa zaxira.
PLATFORM_CARD_NUMBER=
PLATFORM_CARD_OWNER=

# Avtomatik obuna to'lovi — Hamyon API (https://hamyon-api.uz).
# @HamyonAPIBot → /start → shop_id va shop_key. Ikkalasi bo'lsa admin
# panelda «Karta orqali to'lash» chiqadi: pul tushishi bilan do'kon o'zi
# faollashadi. Bo'sh bo'lsa — faqat chek usuli. shop_key MAXFIY.
HAMYON_SHOP_ID=
HAMYON_SHOP_KEY=

# ─── Faqat lokal sinov uchun ──────────────────────────────────
# Xabarlardagi havolalar va Telegram webhook shu manzilga quriladi.
# Bo'sh bo'lsa — https://savdogo.shop
# PUBLIC_BASE_URL=http://localhost:5173
# Botdagi «Do'konni ochish» tugmasi: http://localhost:5173/?shop=<nomi>
# SHOP_BASE_URL=http://localhost:5173
# Hamyon API o'rniga soxta server (lokal sinov)
# HAMYON_API_URL=http://localhost:8098

# ─── Env'da BO'LMAYDIGAN qiymatlar ───────────────────────────
#   Firebase web config (apiKey, projectId...) → src/config/firebase.ts (maxfiy emas)
#   Platforma nomi, domeni, tariflar            → src/platform/plans.ts
#   Do'konlarning Telegram bot tokenlari        → /super panelidan (shopSecrets'da saqlanadi)
